# ====================================================
# LexiGuard Unified Environment Configuration (.env)
# ====================================================

# --- Backend Configuration ---
API_ENV=development
API_PREFIX=/api
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_SIZE_MB=25

# --- AI / LLM Configuration ---
# Options: "auto" | "gemini" | "openai" | "mock"
LLM_PROVIDER=auto

# Option A: Google Gemini (Get key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Option B: OpenAI (Get key at https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Optional model override
LLM_MODEL=

# --- Frontend Configuration ---
VITE_API_BASE_URL=http://localhost:8000/api
