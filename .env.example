# ====================================================
# LexiGuard Unified Environment Configuration (.env)
# ====================================================

# --- Backend Configuration ---
API_ENV=development
API_PREFIX=/api
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_SIZE_MB=25

# --- AI / LLM Configuration ---
# Options: "auto" | "openrouter" | "gemini" | "openai" | "mock"
LLM_PROVIDER=openrouter

# Option 1: OpenRouter (Cheap & powerful models from https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Choices: "deepseek/deepseek-chat", "meta-llama/llama-3.3-70b-instruct", "google/gemini-2.0-flash-001"
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Option 2: Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Option 3: OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
LLM_MODEL=

# --- Frontend Configuration ---
VITE_API_BASE_URL=http://localhost:8000/api
