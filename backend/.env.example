# ==========================================
# LexiGuard Backend Environment Configuration
# ==========================================

# Environment & Server
API_ENV=development
API_PREFIX=/api
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Document Ingestion
MAX_UPLOAD_SIZE_MB=25

# ==========================================
# AI / LLM Configuration
# ==========================================
# Provider Options: "auto" | "gemini" | "openai" | "mock"
# - "auto": Uses Gemini if GEMINI_API_KEY is present, else OpenAI if OPENAI_API_KEY is present, else offline mock engine.
# - "gemini": Google Gemini (recommended)
# - "openai": OpenAI GPT models
# - "mock": Offline deterministic legal NLP heuristic engine (zero API keys needed)
LLM_PROVIDER=auto

# Option A: Google Gemini (Get key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Option B: OpenAI (Get key at https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Optional model override (defaults: gemini-1.5-flash or gpt-4o-mini)
LLM_MODEL=
