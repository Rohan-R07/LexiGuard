# ==========================================
# LexiGuard Backend Environment Configuration
# ==========================================

# Environment & Server
API_ENV=development
API_PREFIX=/api
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Document Ingestion
MAX_UPLOAD_SIZE_MB=25

# ==========================================
# AI / LLM Configuration
# ==========================================
# Provider Options: "auto" | "openrouter" | "gemini" | "openai" | "mock"
# - "auto": Checks OpenRouter -> Gemini -> OpenAI -> Offline fallback
# - "openrouter": OpenRouter (DeepSeek, LLaMA 3.3, Mistral, Qwen, etc.)
# - "gemini": Google Gemini
# - "openai": OpenAI GPT models
# - "mock": Offline deterministic legal NLP heuristic engine (zero API keys needed)
LLM_PROVIDER=openrouter

# ------------------------------------------------------------------
# Option 1: OpenRouter (Super cheap & powerful models)
# Get key at https://openrouter.ai/keys
# ------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Popular cheap / free models on OpenRouter:
# - "deepseek/deepseek-chat"                  (Extremely cheap & smart)
# - "meta-llama/llama-3.3-70b-instruct"      (State of the art open source)
# - "google/gemini-2.0-flash-001"            (Blazing fast & cheap)
# - "mistralai/mistral-small-24b-instruct-2501" (Ultra low latency)
# - "qwen/qwen-2.5-72b-instruct"             (Exceptional reasoning)
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# ------------------------------------------------------------------
# Option 2: Google Gemini (https://aistudio.google.com/app/apikey)
# ------------------------------------------------------------------
GEMINI_API_KEY=

# ------------------------------------------------------------------
# Option 3: OpenAI (https://platform.openai.com/api-keys)
# ------------------------------------------------------------------
OPENAI_API_KEY=
LLM_MODEL=
